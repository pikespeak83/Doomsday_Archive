{
  "appId": "com.pikespeak83.doomsdayfield",
  "productName": "Doomsday Field Terminal",
  "extraMetadata": {
    "main": "electron/clientMain.js"
  },
  "asar": true,
  "compression": "maximum",
  "files": [
    "electron/**/*",
    "backend/**/*",
    "dist/**/*",
    "package.json",
    "assets/**/*"
  ],
  "extraResources": [
    {
      "from": "assets/app-icon.ico",
      "to": "app-icon.ico"
    }
  ],
  "directories": {
    "output": "release"
  },
  "win": {
    "target": ["nsis"],
    "icon": "assets/app-icon.ico",
    "verifyUpdateCodeSignature": false,
    "signAndEditExecutable": false,
    "artifactName": "Doomsday-Field-Terminal-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "warningsAsErrors": false,
    "license": "license-agreement.html",
    "installerIcon": "assets/app-icon.ico",
    "uninstallerIcon": "assets/app-icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Doomsday Field Terminal",
    "runAfterFinish": true,
    "uninstallDisplayName": "${productName} ${version}",
    "displayLanguageSelector": false,
    "artifactName": "Doomsday-Field-Terminal-Setup-${version}.${ext}"
  }
}
