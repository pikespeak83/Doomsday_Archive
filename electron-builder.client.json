{
  "appId": "com.pikespeak83.doomsdayfield",
  "productName": "Doomsday Field Terminal",
  "extraMetadata": {
    "main": "electron/clientMain.js",
    "desktopName": "doomsday-field-terminal.desktop"
  },
  "asar": true,
  "compression": "maximum",
  "files": [
    "electron/**/*",
    "backend/**/*",
    "dist/**/*",
    "package.json",
    "assets/**/*"
  ],
  "extraResources": [
    {
      "from": "assets/app-icon.png",
      "to": "app-icon.png"
    }
  ],
  "directories": {
    "output": "release"
  },
  "linux": {
    "target": ["AppImage", "deb", "tar.gz"],
    "icon": "assets/app-icon.png",
    "category": "Utility",
    "synopsis": "Offline LAN field terminal",
    "syncDesktopName": true,
    "desktop": {
      "entry": {
        "Name": "Doomsday Field Terminal",
        "Comment": "Field device client for the Doomsday Archive",
        "Categories": "Utility;FileTools;Network;"
      }
    },
    "artifactName": "Doomsday-Field-Terminal-Setup-${version}.${ext}"
  }
}
