{
  "name": "doomsday-archive",
  "version": "1.3.2",
  "description": "Doomsday Archive: an offline, LAN-only file archive terminal styled as a government containment OS",
  "author": "pikespeak83",
  "license": "MIT",
  "productName": "Doomsday Archive",
  "desktopName": "doomsday-archive.desktop",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5178 && electron .\"",
    "dev:client": "concurrently \"vite\" \"wait-on tcp:5178 && electron electron/clientMain.js\"",
    "dev:both": "concurrently \"vite\" \"wait-on tcp:5178 && electron .\" \"wait-on tcp:5178 && electron electron/clientMain.js\"",
    "build:web": "vite build",
    "icons": "node scripts/build-app-icon.js",
    "start": "electron .",
    "dist:host": "npm run icons && npm run build:web && electron-builder --linux --publish never",
    "dist:client": "npm run icons && npm run build:web && electron-builder --linux --config electron-builder.client.json --publish never",
    "dist": "npm run icons && npm run build:web && electron-builder --linux --publish never && electron-builder --linux --config electron-builder.client.json --publish never"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ogl": "^1.0.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "rcedit": "^3.1.0",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5",
    "vite": "^7.1.7",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.pikespeak83.doomsdayarchive",
    "productName": "Doomsday Archive",
    "asar": true,
    "compression": "maximum",
    "files": [
      "electron/**/*",
      "backend/**/*",
      "dist/**/*",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "assets/app-icon.png",
      "category": "Utility",
      "maintainer": "pikespeak83 <pikespeak83@users.noreply.github.com>",
      "synopsis": "Offline LAN-only archive terminal",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Doomsday Archive",
          "Comment": "Offline household archive host node",
          "Categories": "Utility;FileTools;Network;"
        }
      },
      "artifactName": "Doomsday-Archive-Setup-${version}.${ext}"
    }
  }
}
